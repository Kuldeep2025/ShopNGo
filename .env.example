# =============================================================================
# ShopNGo Environment Variables
# Copy this file to .env.local and replace all REPLACE_ME values
# NEVER commit .env.local or any file containing real secrets
# =============================================================================

NODE_ENV=development
# On Vercel you can leave APP_URL empty; the production URL is detected automatically.
APP_URL=http://localhost:3000

# Comma-separated emails that become ADMIN on first sign-in (your own email).
ADMIN_EMAILS=you@example.com

# -----------------------------------------------------------------------------
# Firebase Authentication and Analytics (client-side public web config)
# These values are intended for browser use. Restrict the API key by HTTP referrer
# and permitted APIs in Google Cloud; never put Firebase Admin credentials here.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Server-side only – NEVER expose to browser)
# Generate a service account key in Firebase Console → Project Settings → Service accounts
FIREBASE_ADMIN_PROJECT_ID=REPLACE_ME
FIREBASE_ADMIN_CLIENT_EMAIL=REPLACE_ME@REPLACE_ME.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Database – Neon Free PostgreSQL
# Get connection string from https://console.neon.tech
# Use the DIRECT (non-pooled) string when running db:setup / migrations.
# The pooled string (host contains -pooler) is fine for the running app.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Session / encryption secret (generate a long random string)
# openssl rand -base64 32
# -----------------------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# -----------------------------------------------------------------------------
# AI Providers (OFF by default – free models only)
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=off
AI_MODEL=
# Leave empty to auto-use the best free Groq model (llama-3.3-70b-versatile with fallbacks)
AI_FREE_ONLY=true
AI_ALLOW_PAID_MODELS=false
GROQ_API_KEY=
# Paste your Groq key here for local testing (never commit .env.local)
OPENROUTER_API_KEY=
AI_USER_DAILY_REQUEST_LIMIT=10
AI_GLOBAL_DAILY_REQUEST_LIMIT=40
AI_MAX_INPUT_CHARACTERS=4000
AI_MAX_OUTPUT_TOKENS=512
AI_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Storage (local for development, Neon Object Storage later)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET_PUBLIC=
STORAGE_BUCKET_PRIVATE=
UPLOAD_MAX_BYTES=10485760
STORAGE_FREE_QUOTA_LIMIT_BYTES=5000000000

# -----------------------------------------------------------------------------
# Payments – mock only for zero-cost MVP
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENTS_LIVE_ENABLED=false
# Demo payment (no real money). Set to false to disable the demo pay button.
DEMO_PAYMENTS_ENABLED=true

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
LOCATION_FEATURE_ENABLED=false
